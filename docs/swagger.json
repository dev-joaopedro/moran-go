{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/": {
            "get": {
                "description": "Exibe a página inicial",
                "consumes": [
                    "text/html"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Página"
                ],
                "summary": "Página inicial",
                "responses": {
                    "200": {
                        "description": "Página index",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/agendamento": {
            "get": {
                "description": "Exibe a página de agendamento",
                "consumes": [
                    "text/html"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Agendamento"
                ],
                "summary": "Página de agendamento",
                "responses": {
                    "200": {
                        "description": "Página de agendamento",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/cadastro": {
            "get": {
                "description": "Exibe o formulário de cadastro",
                "consumes": [
                    "text/html"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Cadastro"
                ],
                "summary": "Página de cadastro",
                "responses": {
                    "200": {
                        "description": "Formulário de cadastro",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "Realiza login com email e senha",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Autenticação"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "type": "string",
                        "description": "E-mail",
                        "name": "email",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Senha",
                        "name": "password",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redireciona para verificação de token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Credenciais inválidas",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/reenviar-codigo": {
            "post": {
                "description": "Reenvia o código de verificação",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Autenticação"
                ],
                "summary": "Reenvia código",
                "parameters": [
                    {
                        "type": "string",
                        "description": "E-mail",
                        "name": "email",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Novo código enviado",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/registrar": {
            "post": {
                "description": "Realiza o cadastro de novo usuário",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Cadastro"
                ],
                "summary": "Cadastro de usuário",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Nome",
                        "name": "nome",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "E-mail",
                        "name": "email",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Senha",
                        "name": "password",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cadastro realizado com sucesso",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Erro ao cadastrar",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/sucesso": {
            "get": {
                "description": "Exibe mensagem após login/cadastro bem-sucedido",
                "consumes": [
                    "text/html"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Página"
                ],
                "summary": "Página de sucesso",
                "responses": {
                    "200": {
                        "description": "Página de sucesso",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/verificar-token": {
            "get": {
                "description": "Exibe página para verificar o código enviado",
                "consumes": [
                    "text/html"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Autenticação"
                ],
                "summary": "Página de verificação",
                "parameters": [
                    {
                        "type": "string",
                        "description": "E-mail",
                        "name": "email",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Exibe formulário de verificação",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/verificar-token-post": {
            "post": {
                "description": "Verifica o código enviado por email",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Autenticação"
                ],
                "summary": "Verifica código 2FA",
                "parameters": [
                    {
                        "type": "string",
                        "description": "E-mail",
                        "name": "email",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Código",
                        "name": "codigo",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redireciona para página de sucesso",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Código inválido ou expirado",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}